#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl --system stop camellia-remote.service >/dev/null 2>&1 || true
            systemctl --system disable camellia-remote.service >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade)
        if [ -d /run/systemd/system ]; then
            systemctl --system stop camellia-remote.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
