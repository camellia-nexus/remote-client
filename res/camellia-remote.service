[Unit]
Description=Camellia Remote Service
After=network.target systemd-user-sessions.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/camellia-remote --service
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
