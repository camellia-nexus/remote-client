<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<?include ../Includes.wxi?>

		<Binary Id="Custom_Actions_Dll" SourceFile="$(var.CustomActions.TargetDir)$(var.CustomActions.TargetName).dll" />

		<!-- Explicit Best-Effort Custom Actions -->
		<CustomAction Id="CustomActionHello" DllEntry="CustomActionHello" Impersonate="yes" Execute="immediate" Return="ignore" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="RemoveRuntimeGeneratedFiles" DllEntry="RemoveRuntimeGeneratedFiles" Impersonate="no" Execute="deferred" Return="ignore" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="TerminateProcesses" DllEntry="TerminateProcesses" Impersonate="yes" Execute="immediate" Return="ignore" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="TerminateBrokers" DllEntry="TerminateProcesses" Impersonate="yes" Execute="immediate" Return="ignore" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="TryDeleteStartupShortcut" DllEntry="TryDeleteStartupShortcut" Impersonate="yes" Execute="immediate" Return="ignore" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="RemoveAmyuniIdd" DllEntry="RemoveAmyuniIdd" Impersonate="no" Execute="deferred" Return="ignore" BinaryRef="Custom_Actions_Dll"/>

		<!-- Transaction-Critical Custom Actions (Return="check") -->
		<CustomAction Id="SetPropertyIsServiceRunning" DllEntry="SetPropertyIsServiceRunning" Impersonate="yes" Execute="immediate" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="SetPropertyServiceStop" DllEntry="SetPropertyFromConfig" Impersonate="yes" Execute="immediate" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="CreateStartService" DllEntry="CreateStartService" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="TryStopDeleteService" DllEntry="TryStopDeleteService" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="AddFirewallRules" DllEntry="AddFirewallRules" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="RemoveFirewallRules" DllEntry="AddFirewallRules" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="AddRegSoftwareSASGeneration" DllEntry="AddRegSoftwareSASGeneration" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="InstallPrinter" DllEntry="InstallPrinter" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="UninstallPrinter" DllEntry="UninstallPrinter" Impersonate="no" Execute="deferred" Return="check" BinaryRef="Custom_Actions_Dll"/>

		<!-- Paired Rollback Custom Actions (Execute="rollback" Return="check") -->
		<CustomAction Id="RollbackCreateStartService" DllEntry="TryStopDeleteService" Impersonate="no" Execute="rollback" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="RollbackFirewallRules" DllEntry="AddFirewallRules" Impersonate="no" Execute="rollback" Return="check" BinaryRef="Custom_Actions_Dll"/>
		<CustomAction Id="RollbackPrinter" DllEntry="UninstallPrinter" Impersonate="no" Execute="rollback" Return="check" BinaryRef="Custom_Actions_Dll"/>
	</Fragment>
</Wix>
