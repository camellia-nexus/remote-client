[Desktop Entry]
Name=Camellia Remote
GenericName=Remote Desktop
Comment=Remote Desktop
Exec=camellia-remote %u
Icon=camellia-remote
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
MimeType=x-scheme-handler/camellia-remote;
Keywords=internet;linux;dart;rust;remote-control;p2p;teamviewer;rust-lang;rdp;remote-desktop;vnc;
Actions=new-window;
StartupWMClass=camellia-remote

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=camellia-remote %u
