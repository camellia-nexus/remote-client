# arg 1:  the new package version
post_install() {
	# do something here
	cp /usr/share/camellia/files/camellia-remote.service /etc/systemd/system/camellia-remote.service
	cp /usr/share/camellia/files/camellia-remote.desktop /usr/share/applications/
	cp /usr/share/camellia/files/camellia-remote-link.desktop /usr/share/applications/
	systemctl daemon-reload
	systemctl enable camellia-remote
	systemctl start camellia-remote
	update-desktop-database
}

# arg 1:  the new package version
# arg 2:  the old package version
pre_upgrade() {
    systemctl stop camellia-remote || true
}

# arg 1:  the new package version
# arg 2:  the old package version
post_upgrade() {
	cp /usr/share/camellia/files/camellia-remote.service /etc/systemd/system/camellia-remote.service
	cp /usr/share/camellia/files/camellia-remote.desktop /usr/share/applications/
	cp /usr/share/camellia/files/camellia-remote-link.desktop /usr/share/applications/
	systemctl daemon-reload
	systemctl enable camellia-remote
	systemctl start camellia-remote
	update-desktop-database
}

# arg 1:  the old package version
pre_remove() {
	systemctl stop camellia-remote || true
	systemctl disable camellia-remote || true
	rm /etc/systemd/system/camellia-remote.service || true
}

# arg 1:  the old package version
post_remove() {
	rm /usr/share/applications/camellia-remote.desktop || true
	rm /usr/share/applications/camellia-remote-link.desktop || true
	update-desktop-database
}
