<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.camellia.remote_service</string>

	<key>AssociatedBundleIdentifiers</key>
	<string>com.camellia.remote</string>

        <key>KeepAlive</key>
        <true/>
        <key>ThrottleInterval</key>
        <integer>1</integer>
        <key>ProgramArguments</key>
        <array>
            <string>/Applications/Camellia.app/Contents/MacOS/service</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/Applications/Camellia.app/Contents/MacOS/</string>
        <key>StandardErrorPath</key>
        <string>/var/log/camellia_remote_service.err</string>
        <key>StandardOutPath</key>
        <string>/var/log/camellia_remote_service.out</string>
    </dict>
</plist>
